{
  "name": "@bitsocial/bitsocial-seeder",
  "type": "module",
  "version": "0.5.0",
  "description": "Seed Bitsocial community pages and pubsub topics through a Bitsocial CLI daemon.",
  "keywords": [
    "bitsocial",
    "pkc",
    "ipfs",
    "seeder",
    "pubsub"
  ],
  "author": "Bitsocial Forge",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/start.js",
  "bin": {
    "bitsocial-seeder": "dist/bin/bitsocial-seeder.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "changelog": "node scripts/generate-changelog.mts",
    "changelog:release-notes": "node scripts/changelog-release-notes.mts",
    "prepack": "npm run build",
    "start": "node start.ts",
    "test": "npm run typecheck && node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@bitsocial/bitsocial-cli": "0.19.84",
    "@bitsocial/pubsub-voting": "0.1.4",
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@helia/delegated-routing-v1-http-api-client": "6.0.1",
    "@ipld/dag-cbor": "9.2.7",
    "@ipshipyard/libp2p-auto-tls": "2.0.2",
    "@libp2p/autonat": "3.0.23",
    "@libp2p/bootstrap": "12.0.26",
    "@libp2p/crypto": "5.1.21",
    "@libp2p/fetch": "4.1.7",
    "@libp2p/gossipsub": "16.0.3",
    "@libp2p/http": "2.0.6",
    "@libp2p/identify": "4.1.8",
    "@libp2p/keychain": "6.1.4",
    "@libp2p/tcp": "11.0.22",
    "@libp2p/websockets": "10.1.16",
    "@pkcprotocol/pkc-js": "0.0.72",
    "@russellthehippo/honker-node": "0.3.3",
    "blockstore-fs": "3.0.3",
    "datastore-fs": "12.0.1",
    "dotenv": "16.0.3",
    "helia": "6.1.4",
    "javascript-time-ago": "2.5.10",
    "kubo-rpc-client": "6.1.0",
    "libp2p": "3.3.5",
    "multiformats": "13.4.2",
    "p-limit": "6.2.0",
    "string-strip-html": "13.4.8",
    "strip-json-comments": "5.0.3",
    "viem": "2.54.0",
    "yargs": "17.7.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitsocialnet/bitsocial-seeder.git"
  },
  "optionalDependencies": {
    "bufferutil": "4.1.0",
    "utf-8-validate": "6.0.6"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "patch-package": "^8.0.1",
    "typescript": "7.0.2"
  }
}
