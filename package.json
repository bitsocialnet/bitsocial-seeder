    "@pkcprotocol/pkc-js": "0.0.69",
    "@russellthehippo/honker-node": "0.3.3",
    "blockstore-core": "6.1.3",
    "dotenv": "16.0.3",
    "helia": "6.1.4",
    "javascript-time-ago": "2.5.10",
